# --- Modes (obligatoire) ---
TRADING_MODE=DEMO
# DEMO | BACKTEST | PAPER_FORWARD

# --- Application ---
APP_VERSION=0.1.0-dev
GIT_COMMIT=local
SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8808
CORS_ORIGINS=http://localhost:5180,http://localhost:3000

# --- Base de données ---
DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5432/llm_trading_lab

# --- Redis / Worker (optionnel) ---
REDIS_URL=redis://localhost:6379/0
WORKER_ENABLED=true

# --- Exécution ---
EXECUTION_ENGINE=local_canonical
EXECUTION_COMMISSION_BPS=0.1
EXECUTION_SPREAD_BPS=1.0
EXECUTION_SLIPPAGE_BPS=2.0

# Hôtes ordres autorisés (séparés des données)
ALLOWED_ORDER_HOSTS=paper-api.alpaca.markets
BLOCK_REAL_TRADING=true

# --- Données (optionnel, pas requis en DEMO) ---
ALLOWED_DATA_HOSTS=data.alpaca.markets,financialmodelingprep.com

# --- LLM (optionnel — DEMO n'en a pas besoin) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Alpaca Paper (étape 5 — optionnel) ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Auth locale (démo) ---
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
